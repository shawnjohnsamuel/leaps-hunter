#!/bin/sh
# Pre-commit secret scan. This repo is destined to be public; nothing
# account-adjacent or secret-shaped may enter its history — history is forever.
GITLEAKS="$(command -v gitleaks 2>/dev/null || echo "$HOME/.local/bin/gitleaks")"
if [ -x "$GITLEAKS" ]; then
  if ! "$GITLEAKS" git --pre-commit --staged --redact; then
    echo ""
    echo "COMMIT BLOCKED: gitleaks flagged a potential secret in staged changes." >&2
    echo "Review the finding above. If it is a true false positive, add a" >&2
    echo "gitleaks:allow comment on that line or a .gitleaksignore entry." >&2
    exit 1
  fi
else
  echo "WARNING: gitleaks not found — secret scan SKIPPED for this commit." >&2
fi
